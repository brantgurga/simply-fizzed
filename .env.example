# Environment variables for Simply Fizzed. Every variable below is required.
#
# Local development and e2e need no setup: the committed `.env` already provides
# demo values that point the app at the Firebase Emulator Suite.
#
# For a PRODUCTION build, copy the relevant values into a gitignored
# `.env.production.local` (or supply them via CI) so real values and secrets are
# never committed. Only `VITE_`-prefixed variables are exposed to the client.

# Firebase web app configuration.
# Firebase console > Project settings > General > Your apps > SDK setup.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Google Maps JavaScript API key. Treat as a secret: keep the real value in a
# gitignored `.env.*.local` file or CI. Never commit a real key.
VITE_GOOGLE_MAPS_API_KEY=
