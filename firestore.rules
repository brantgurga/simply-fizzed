rules_version = "2";

// Firestore security rules for location-based soda discovery. Search data is
// public, while signed-in fans may create strictly validated, attributed
// locations, sodas, and availability. Existing contributions cannot be changed or
// deleted from the client; moderation is handled separately.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function restrictionPath(userId) {
      return /databases/$(database)/documents/restrictions/$(userId);
    }

    // Invalid expiration data fails closed. For valid records, equality is
    // intentionally inactive: only expiresAt > request.time is active.
    function hasActiveRestriction(userId) {
      return exists(restrictionPath(userId))
        ? (!get(restrictionPath(userId)).data.keys().hasAny(["expiresAt"])
          || !(get(restrictionPath(userId)).data.expiresAt is timestamp)
          || get(restrictionPath(userId)).data.expiresAt > request.time)
        : false;
    }

    function canWriteOwnData(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function canWriteCommunityData() {
      return isAuthenticated() && !hasActiveRestriction(request.auth.uid);
    }

    function reviewPath(userId, sodaId) {
      return /databases/$(database)/documents/profiles/$(userId)/reviews/$(sodaId);
    }

    function hasTextualReviewAfter(userId, sodaId) {
      return existsAfter(reviewPath(userId, sodaId))
        && getAfter(reviewPath(userId, sodaId)).data.markdown != null;
    }

    function isNonEmptyString(value, maxLength) {
      return value is string
        && value.matches(".*[\\p{L}\\p{M}\\p{N}\\p{P}\\p{S}].*")
        && value.size() <= maxLength;
    }

    function isValidAttributionName(value) {
      return value == "" || isNonEmptyString(value, 320);
    }

    function isValidActionTime(value) {
      return value is timestamp && value <= request.time + duration.value(5, "m");
    }

    function isValidAddress(address) {
      return address is map
        && address.keys().hasOnly(["street", "city", "state", "postalCode"])
        && isNonEmptyString(address.street, 200)
        && isNonEmptyString(address.city, 100)
        && isNonEmptyString(address.state, 100)
        && isNonEmptyString(address.postalCode, 20);
    }

    function isValidGeo(geo) {
      return geo is map
        && geo.keys().hasOnly(["lat", "lng"])
        && geo.lat is number
        && geo.lat >= -90
        && geo.lat <= 90
        && geo.lng is number
        && geo.lng >= -180
        && geo.lng <= 180;
    }

    function isValidSoda(data, sodaId) {
      return data.keys().hasOnly([
          "name", "brand", "flavor", "initialAvailabilityId",
          "createdBy", "createdByName", "createdAt",
          "updatedBy", "updatedByName", "updatedAt"
        ])
        && isNonEmptyString(data.name, 200)
        && isNonEmptyString(data.brand, 200)
        && isNonEmptyString(data.flavor, 200)
        && isNonEmptyString(data.initialAvailabilityId, 1500)
        && data.createdBy == request.auth.uid
        && isValidAttributionName(data.createdByName)
        && data.createdAt == request.time
        && data.updatedBy == request.auth.uid
        && isValidAttributionName(data.updatedByName)
        && data.updatedByName == data.createdByName
        && data.updatedAt == request.time
        && existsAfter(
          /databases/$(database)/documents/availability/$(data.initialAvailabilityId)
        )
        && getAfter(
          /databases/$(database)/documents/availability/$(data.initialAvailabilityId)
        ).data.sodaId == sodaId;
    }

    function isValidAvailability(data) {
      return data.keys().hasOnly([
          "locationId", "sodaId", "form",
          "sodaName", "sodaBrand", "sodaFlavor", "canSample", "canPurchase",
          "createdBy", "createdByName", "createdAt",
          "updatedBy", "updatedByName", "updatedAt"
        ])
        && isNonEmptyString(data.locationId, 1500)
        && isNonEmptyString(data.sodaId, 1500)
        && data.form in ["draft", "can", "bottle"]
        && isNonEmptyString(data.sodaName, 200)
        && isNonEmptyString(data.sodaBrand, 200)
        && isNonEmptyString(data.sodaFlavor, 200)
        && data.canSample in ["yes", "no", "unknown"]
        && data.canPurchase in ["yes", "no", "unknown"]
        && data.updatedBy == request.auth.uid
        && isValidAttributionName(data.updatedByName)
        && isValidActionTime(data.updatedAt)
        && exists(/databases/$(database)/documents/locations/$(data.locationId))
        && existsAfter(/databases/$(database)/documents/sodas/$(data.sodaId))
        && data.sodaName == getAfter(/databases/$(database)/documents/sodas/$(data.sodaId)).data.name
        && data.sodaBrand == getAfter(/databases/$(database)/documents/sodas/$(data.sodaId)).data.brand
        && data.sodaFlavor == getAfter(/databases/$(database)/documents/sodas/$(data.sodaId)).data.flavor;
    }

    function hasValidAvailabilityCreation(data) {
      return data.keys().hasAll(["createdBy", "createdByName", "createdAt"])
        && data.createdBy == request.auth.uid
        && isValidAttributionName(data.createdByName)
        && isValidActionTime(data.createdAt)
        && data.updatedByName == data.createdByName
        && data.updatedAt == data.createdAt;
    }

    function isValidVerification(data) {
      return data.keys().hasOnly(["locationId", "verifiedBy", "verifiedByName", "verifiedAt"])
        && isNonEmptyString(data.locationId, 1500)
        && data.verifiedBy == request.auth.uid
        && isValidAttributionName(data.verifiedByName)
        && isValidActionTime(data.verifiedAt)
        && exists(/databases/$(database)/documents/locations/$(data.locationId));
    }

    function isValidCurrentReview(data, userId, sodaId) {
      return data.authorId == userId
        && data.sodaOfferingId == sodaId
        && isNonEmptyString(data.sodaOfferingId, 1500)
        && isValidAttributionName(data.authorName)
        && isNonEmptyString(data.sodaName, 200)
        && isNonEmptyString(data.sodaBrand, 200)
        && isNonEmptyString(data.sodaFlavor, 200)
        && (data.markdown == null || isNonEmptyString(data.markdown, 3000))
        && data.contentLength is int
        && data.contentLength >= 0
        && data.contentLength <= 2000
        && ((data.markdown == null && data.contentLength == 0)
          || (data.markdown != null && data.contentLength > 0))
        && data.version is int
        && data.version >= 1
        && isValidActionTime(data.authoredAt)
        && data.baseModerationCycle is int
        && data.baseModerationCycle >= 0
        && (data.baseApprovedVersion == null
          || (data.baseApprovedVersion is int && data.baseApprovedVersion >= 1))
        && data.mutationId is string
        && data.mutationId.matches(
          "[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}"
        )
        && (data.markdown == null
          || (existsAfter(
              /databases/$(database)/documents/profiles/$(userId)/ratings/$(sodaId)
            )
            && getAfter(
              /databases/$(database)/documents/profiles/$(userId)/ratings/$(sodaId)
            ).data.rating != null));
    }

    function isValidRating(data, userId, ratingId) {
      return data.keys().hasOnly([
          "userId", "sodaOfferingId", "sodaName", "sodaBrand", "sodaFlavor",
          "rating", "firstRecorded", "lastRatedAt"
        ])
        && data.userId == userId
        && data.sodaOfferingId == ratingId
        && isNonEmptyString(data.sodaOfferingId, 1500)
        && isNonEmptyString(data.sodaName, 200)
        && isNonEmptyString(data.sodaBrand, 200)
        && isNonEmptyString(data.sodaFlavor, 200)
        && (data.rating == null || (data.rating is number && data.rating >= 1 && data.rating <= 5))
        && ((data.rating == null && data.lastRatedAt == null)
          || (data.rating != null && data.lastRatedAt == request.time));
    }

    match /locations/{locationId} {
      allow read: if true;
      allow create: if canWriteCommunityData()
        && request.resource.data.keys().hasOnly([
          "name", "address", "geo", "geohash",
          "createdBy", "createdByName", "createdAt",
          "updatedBy", "updatedByName", "updatedAt"
        ])
        && isNonEmptyString(request.resource.data.name, 200)
        && isValidAddress(request.resource.data.address)
        && isValidGeo(request.resource.data.geo)
        && isNonEmptyString(request.resource.data.geohash, 20)
        && request.resource.data.createdBy == request.auth.uid
        && isValidAttributionName(request.resource.data.createdByName)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && isValidAttributionName(request.resource.data.updatedByName)
        && request.resource.data.updatedByName == request.resource.data.createdByName
        && request.resource.data.updatedAt == request.time;
      allow update, delete: if false;
    }

    match /sodas/{sodaId} {
      allow read: if true;
      allow create: if canWriteCommunityData()
        && sodaId.matches("[^$]+")
        && isValidSoda(request.resource.data, sodaId);
      allow update, delete: if false;
    }

    match /availability/{availabilityId} {
      allow read: if true;
      allow create: if canWriteCommunityData()
        && request.resource.data.locationId.matches("[^$]+")
        && request.resource.data.sodaId.matches("[^$]+")
        && availabilityId == request.resource.data.locationId
          + "$" + request.resource.data.sodaId
          + "$" + request.resource.data.form
        && isValidAvailability(request.resource.data)
        && hasValidAvailabilityCreation(request.resource.data);
      allow update: if canWriteCommunityData()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "canSample", "canPurchase", "updatedBy", "updatedByName", "updatedAt"
        ])
        && isValidAvailability(request.resource.data)
        && (!resource.data.keys().hasAny(["updatedAt"])
          || request.resource.data.updatedAt > resource.data.updatedAt);
      allow delete: if false;
    }

    match /verifications/{verificationId} {
      allow read: if true;
      allow create: if canWriteCommunityData() && isValidVerification(request.resource.data);
      allow update, delete: if false;
    }

    // Aggregate catalog ratings require a collection-group query across public inventories.
    match /{profilePath=**}/ratings/{ratingId} {
      allow read: if true;
    }

    match /profiles/{userId} {
      allow get: if true;
      allow list, create, update, delete: if false;

      match /ratings/{ratingId} {
        allow read: if true;
        allow create: if canWriteOwnData(userId)
          && request.resource.data.firstRecorded == request.time
          && isValidRating(request.resource.data, userId, ratingId)
          && exists(/databases/$(database)/documents/sodas/$(request.resource.data.sodaOfferingId))
          && request.resource.data.sodaName
            == get(/databases/$(database)/documents/sodas/$(request.resource.data.sodaOfferingId)).data.name
          && request.resource.data.sodaBrand
            == get(/databases/$(database)/documents/sodas/$(request.resource.data.sodaOfferingId)).data.brand
          && request.resource.data.sodaFlavor
            == get(/databases/$(database)/documents/sodas/$(request.resource.data.sodaOfferingId)).data.flavor;
        allow update: if canWriteOwnData(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "rating", "lastRatedAt"
          ])
          && isValidRating(request.resource.data, userId, ratingId)
          && (request.resource.data.rating != null
            || !hasTextualReviewAfter(userId, ratingId));
        allow delete: if canWriteOwnData(userId)
          && !hasTextualReviewAfter(userId, ratingId);
      }

      match /reviews/{sodaId} {
        allow get, list: if canWriteOwnData(userId);
        allow create: if canWriteOwnData(userId)
          && canWriteCommunityData()
          && request.resource.data.keys().hasOnly([
            "authorId", "authorName", "sodaOfferingId", "sodaName", "sodaBrand", "sodaFlavor",
            "markdown", "contentLength", "version", "authoredAt", "baseModerationCycle",
            "baseApprovedVersion", "mutationId"
          ])
          && request.resource.data.markdown != null
          && request.resource.data.version == 1
          && request.resource.data.baseModerationCycle == 0
          && request.resource.data.baseApprovedVersion == null
          && isValidCurrentReview(request.resource.data, userId, sodaId);
        allow update: if canWriteOwnData(userId)
          && (canWriteCommunityData() || request.resource.data.markdown == null)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "markdown", "contentLength", "version", "authoredAt", "baseModerationCycle",
            "baseApprovedVersion", "mutationId"
          ])
          && request.resource.data.version == resource.data.version + 1
          && request.resource.data.mutationId != resource.data.mutationId
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.authorName == resource.data.authorName
          && request.resource.data.sodaOfferingId == resource.data.sodaOfferingId
          && request.resource.data.sodaName == resource.data.sodaName
          && request.resource.data.sodaBrand == resource.data.sodaBrand
          && request.resource.data.sodaFlavor == resource.data.sodaFlavor
          && isValidCurrentReview(request.resource.data, userId, sodaId);
        allow delete: if false;
      }
    }

    match /publishedReviews/{reviewId} {
      allow read: if true;
      allow write: if false;
    }

    match /reviewModerationQueue/{reviewId} {
      allow read, write: if false;
    }

    match /reviewAudit/{document=**} {
      allow read, write: if false;
    }

    match /restrictions/{userId} {
      allow get: if canWriteOwnData(userId);
      allow list, create, update, delete: if false;
    }

    match /userModeration/{userId} {
      allow read, write: if false;
    }

    // Audit events and recovery state are available only through trusted functions.
    match /userAudit/{document=**} {
      allow read, write: if false;
    }

    match /userAuditState/{document=**} {
      allow read, write: if false;
    }

    match /userAuditOperations/{document=**} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
