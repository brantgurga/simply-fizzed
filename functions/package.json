    "@types/sinon": "^21.0.0",
    "expect": "^30.5.2",
    "mocha": "^12.0.3",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "sinon": "^22.1.0",
    "tsx": "^4.20.6",
