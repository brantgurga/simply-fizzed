{
  "name": "simply-fizzed",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint . .github/scripts",
    "lint:fix": "oxlint --fix . .github/scripts",
    "lint:types": "oxlint --type-aware . .github/scripts",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore --project demo-simply-fizzed \"vitest run --config vitest.rules.config.ts\"",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "emulators": "firebase emulators:start --project demo-simply-fizzed",
    "emulators:hosting": "firebase emulators:start --only hosting --project demo-simply-fizzed",
    "emulators:e2e": "firebase emulators:start --only hosting,firestore,auth --project demo-simply-fizzed",
    "preview": "vite preview",
    "prepare": "husky"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@firebase-oss/ui-core": "^7.1.0",
    "@firebase-oss/ui-react": "^7.1.0",
    "@firebase-oss/ui-styles": "^7.1.0",
    "@fontsource/roboto": "^5.3.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "firebase": "^12.19.0",
    "geofire-common": "^6.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@actions/github": "^9.1.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@tsconfig/recommended": "^1.0.13",
    "@tsconfig/strictest": "^2.0.8",
    "@tsconfig/vite-react": "^8.1.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/wait-on": "^5.3.4",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.31.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.5.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "typescript": "~7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1",
    "wait-on": "^9.1.0"
  },
  "overrides": {
    "@grpc/grpc-js": "1.14.5",
    "@opentelemetry/core": "2.8.0",
    "basic-ftp": "6.2.1",
    "qs": "6.16.0",
    "uuid@<11.1.1": "11.1.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,html}": "oxfmt",
    "*.{ts,tsx,js,jsx}": "oxlint"
  },
  "overrideNotes": {
    "@opentelemetry/core": "Temporary security pin for GHSA-8988-4f7v-96qf; remove when firebase-tools through @google-cloud/pubsub permits @opentelemetry/core >=2.8.0.",
    "uuid@<11.1.1": "Temporary security pin for GHSA-w5hq-g745-h8pq; remove when firebase-tools and its transitive dependencies no longer install uuid <11.1.1.",
    "@grpc/grpc-js": "Temporary security pin for GHSA-m9gg-hp2v-232j and GHSA-f596-whhp-79r4; remove when firebase and Firebase tooling install @grpc/grpc-js >=1.14.5.",
    "basic-ftp": "Temporary security pin for GHSA-c475-qrg2-pj4r; remove when firebase-tools through proxy-agent permits basic-ftp >=6.2.1.",
    "qs": "Temporary security pin for GHSA-4mjr-xmp4-gh2g and GHSA-x5fp-wj9c-mxmx; remove when firebase-tools permits qs >=6.16.0."
  }
}
