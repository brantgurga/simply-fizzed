{
  "$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**/*.json",
      "**/*.jsonc",
      "!**/node_modules",
      "!**/dist",
      "!**/playwright-report",
      "!**/test-results",
      "!package-lock.json"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "enabled": true
  },
  "json": {
    "formatter": {
      "enabled": false
    }
  }
}
