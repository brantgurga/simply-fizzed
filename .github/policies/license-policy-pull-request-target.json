{
  "name": "Allow pull_request_target for trusted license policy",
  "enforcement": "active",
  "conditions": {
    "workflow_path": {
      "include": [".github/workflows/license-policy.yml"],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "restrict_action_events",
      "parameters": {
        "allowed_events": ["pull_request_target"]
      }
    }
  ]
}
