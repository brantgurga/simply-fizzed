# Committed demo configuration. These values are intentionally NOT secret: local
# development and the end-to-end tests run entirely against the Firebase Emulator
# Suite, and the `demo-` project id keeps everything offline. Real production
# values are supplied via gitignored `.env.*.local` files or CI and must never be
# committed here. See `.env.example` for the full list of variables.

# Firebase web app configuration. The `demo-` project id makes src/firebase.ts
# connect Firestore to the local emulator automatically.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-simply-fizzed.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-simply-fizzed
VITE_FIREBASE_STORAGE_BUCKET=demo-simply-fizzed.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_MEASUREMENT_ID=G-DEMO000000

# Placeholder Google Maps key. Never commit a real key; provide it through a
# gitignored `.env.*.local` file or CI for production builds.
VITE_GOOGLE_MAPS_API_KEY=demo-google-maps-api-key
